# Copy this file to .env in the repo root (next to docker-compose.yml).
# DO NOT COMMIT .env TO GIT
# NOTE: Don't use quotes around values. Quotes will break the script.
#
# Generate DEVICE_ID and ANDROID_ID once, then keep them forever:
#   python3 -c "import os; print('DEVICE_ID=' + os.urandom(16).hex()); print('ANDROID_ID=' + os.urandom(8).hex())"
# Leave BOT_NODE_JID empty on the first login. The bot prints the real node after login.

DEVICE_ID=
ANDROID_ID=

BOT_USERNAME=bot_username
BOT_PASSWORD=bot_password
BOT_NODE_JID=

# Kik's current login requires a reCAPTCHA Enterprise token from the official Android app.
# Leave this empty unless you already have one. The bot cannot create it.
RECAPTCHA_TOKEN=

# Used by examples/machi_bot.py. Do not commit the real key.
OPENAI_API_KEY=
# Cheapest chat model. gpt-4o-mini still works if you prefer that older mini model.
OPENAI_MODEL=gpt-5-nano
